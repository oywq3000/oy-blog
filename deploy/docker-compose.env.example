# 复制为服务器 /home/oy/app/oyblogdeploy/oyblog-back/.env 并填真实值（该文件不入库）
# 警告：NACOS_HOST 不能留空，空串会拼出 http://:8848 导致 Nacos 连不上
# ===== 中间件地址：业务容器与中间件同在 oyblog_oyblog-net 网络，直接用容器名直连 =====
# 容器名以服务器实际 docker ps 为准（Nacos 的容器名是 nacos-registry）
MYSQL_HOST=mysql
REDIS_HOST=redis
NACOS_HOST=nacos-registry
ES_HOST=elasticsearch
MQ_HOST=rabbitmq
MINIO_HOST=minio
# Sentinel dashboard 已容器化在同网络（sentinel-dashboard:8858）
SENTINEL_HOST=sentinel-dashboard
# ===== 时区 =====
TZ=Asia/Shanghai
# 6 个 JVM 内存上限（服务器空余约 2G，贴边跑；gateway/article/search 在 compose 里覆盖）
JAVA_TOOL_OPTIONS="-Xms64m -Xmx128m -XX:MaxMetaspaceSize=128m"
# ===== 邮箱（QQ SMTP 授权码；键名必须叫 MAIL_TOKEN，仅 user-service 使用）=====
MAIL_USERNAME=your-qq-email@qq.com
MAIL_TOKEN=your-smtp-auth-code
# ===== Elasticsearch 账号（ES 开启安全认证时填写）=====
ES_USERNAME=elastic
ES_PASSWORD=your-es-password
# ===== MinIO 下载链接前缀（返回给前端/浏览器，必须浏览器可达的 Tailscale IP）=====
# 必填：MINIO_HOST 是容器名 minio，浏览器解析不了，缺了它下载链接会变成 http://minio:9000/... 打不开
STORAGE_MINIOFILEDOMAIN=http://100.110.148.14:9090
# ===== Python Agent 地址（独立部署在 /home/oy/app/oyblogdeploy/blogagent/，同网络容器名直连）=====
# 容器名 oy-blog-python-agent 由 blogagent 的 compose 定义；同网段二层直连，绕过宿主机防火墙
AGENT_PYTHON_URL=http://oy-blog-python-agent:8001
# ===== 邮件验证链接前缀（前端上线后再打开，并改为实际地址）=====
# APP_HOST=http://100.110.148.14:8080
# ===== ELK 日志（Filebeat 采集，复用 ES）=====
# ES_USERNAME/ES_PASSWORD 已在上方 Elasticsearch 账号段定义，Filebeat 复用同一组变量
# ===== 审核消费并发度（article-service；不填用 application.yml 默认 4/2）=====
# 天花板由 BlogAgent/DeepSeek 并发额度决定；429 会被重试阶梯接住（10s/30s/90s → 转人工，fail-closed）
MODERATION_CONCURRENCY=4
MODERATION_PREFETCH=2
# ===== ES 索引消费者并发度（search-service；不填用 application.yml 默认 3）=====
# 3 = article.index 的分区数（同篇仍保序：key=articleId 恒定落同一分区，一分区一线程）。
# 注意 search-service 的 mem_limit 只有 512m，而 2026-09-13 重放实测峰值 489.6MiB（95.6%）：
# 每多一个消费线程就多一份拉取缓冲/反序列化开销，重放期一旦逼近上限就把这里降到 2 或 1 再
# docker compose up -d search-service（jar 内 yml 已写成 ${KAFKA_LISTENER_CONCURRENCY:3}，不必重新打包）。
KAFKA_LISTENER_CONCURRENCY=3
# ===== article-service 连接池上限（默认 16）=====
DB_POOL_MAX=16
# ===== article-service 上传体积上限（默认 5MB / 10MB）=====
# 不设则用 Spring 默认 1MB，专栏封面这类原图会被 MaxUploadSizeExceededException 拒成 500
# （2026-09-12 线上故障）。前端已降采样到 100~250KB，这里只是给其它客户端留余量。
MULTIPART_MAX_FILE_SIZE=5MB
MULTIPART_MAX_REQUEST_SIZE=10MB
# 注意：上面两个名字只在"已重新打包、jar 内 application.yml 带 ${...} 占位符"后生效。
# 想在旧 jar 上立刻生效（免重新打包），用 Spring 的宽松绑定名（优先级高于 jar 内 yml）：
# SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
# SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB
