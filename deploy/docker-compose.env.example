# 复制为服务器 /home/oy/app/oyblogdeploy/oyblog-back/.env 并填真实值（该文件不入库）
# 警告：NACOS_HOST 不能留空，空串会拼出 http://:8848 导致 Nacos 连不上
# ===== 中间件地址：业务容器与中间件同在 oyblog_oyblog-net 网络，直接用容器名直连 =====
# 容器名以服务器实际 docker ps 为准（Nacos 的容器名是 nacos-registry）
MYSQL_HOST=mysql
REDIS_HOST=redis
NACOS_HOST=nacos-registry
ES_HOST=elasticsearch
MQ_HOST=rabbitmq
MINIO_HOST=minio
# Sentinel dashboard 已容器化在同网络（sentinel-dashboard:8858）
SENTINEL_HOST=sentinel-dashboard
# ===== 时区 =====
TZ=Asia/Shanghai
# 7 个 JVM 内存上限（服务器空余约 2G，贴边跑；gateway/article/search 在 compose 里覆盖）
JAVA_TOOL_OPTIONS="-Xms64m -Xmx128m -XX:MaxMetaspaceSize=128m"
# ===== 邮箱（QQ SMTP 授权码；键名必须叫 MAIL_TOKEN，user/message 两服务共用）=====
MAIL_USERNAME=your-qq-email@qq.com
MAIL_TOKEN=your-smtp-auth-code
# ===== Elasticsearch 账号（ES 开启安全认证时填写）=====
ES_USERNAME=elastic
ES_PASSWORD=your-es-password
# ===== MinIO 下载链接前缀（返回给前端/浏览器，必须浏览器可达的 Tailscale IP）=====
# 必填：MINIO_HOST 是容器名 minio，浏览器解析不了，缺了它下载链接会变成 http://minio:9000/... 打不开
STORAGE_MINIOFILEDOMAIN=http://100.110.148.14:9090
# ===== Python Agent 地址（test-agent 暂未上线，连不上不影响其他功能）=====
AGENT_PYTHON_URL=http://100.110.148.14:8001
# ===== 邮件验证链接前缀（前端上线后再打开，并改为实际地址）=====
# APP_HOST=http://100.110.148.14:8080
