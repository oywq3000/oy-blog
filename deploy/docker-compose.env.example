# 复制为服务器 /home/oy/app/oyblogdeploy/.env 并填真实值（该文件不入库）
# 警告：NACOS_HOST 不能留空，空串会拼出 http://:8848 导致 Nacos 连不上
# ===== 中间件地址（bridge/docker0 网段已被 NAS 防火墙放行，走宿主机已发布端口）=====
MYSQL_HOST=100.110.148.14
REDIS_HOST=100.110.148.14
NACOS_HOST=100.110.148.14
ES_HOST=100.110.148.14
MQ_HOST=100.110.148.14
MINIO_HOST=100.110.148.14
SENTINEL_HOST=100.110.148.14
# ===== 时区 =====
TZ=Asia/Shanghai
# 7 个 JVM 内存上限（服务器空余约 2G，贴边跑；gateway/article/search 在 compose 里覆盖）
JAVA_TOOL_OPTIONS="-Xms64m -Xmx128m -XX:MaxMetaspaceSize=128m"
# ===== 邮箱（QQ SMTP 授权码；键名必须叫 MAIL_TOKEN，user/message 两服务共用）=====
MAIL_USERNAME=your-qq-email@qq.com
MAIL_TOKEN=your-smtp-auth-code
# ===== Elasticsearch 账号（ES 开启安全认证时填写）=====
ES_USERNAME=elastic
ES_PASSWORD=your-es-password
# ===== Python Agent 地址（test-agent 暂未上线，连不上不影响其他功能）=====
AGENT_PYTHON_URL=http://100.110.148.14:8001
# ===== 邮件验证链接前缀（前端上线后再打开，并改为实际地址）=====
# APP_HOST=http://100.110.148.14:8080
