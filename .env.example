# 复制本文件为 .env 即可使用（.env 已被 .gitignore 忽略，不会提交仓库）
# 中间件地址按组件拆分，变量名与各服务 yml 里的 ${XXX_HOST:...} 占位符一一对应
# 日常换 IP：只改下面几行，重启对应服务即可生效
MYSQL_HOST=192.168.200.130
REDIS_HOST=192.168.200.130
NACOS_HOST=192.168.200.130
ES_HOST=192.168.200.130
MQ_HOST=192.168.200.130
MINIO_HOST=192.168.200.130
SENTINEL_HOST=192.168.200.130
# Nacos 命名空间（可选）：本地开发实例与服务器容器隔离用，ID 在 Nacos 控制台"命名空间"页复制
# 不设（默认）= 注册到 public，与服务器容器混在一起，服务器网关会分流到本机
# SPRING_CLOUD_NACOS_DISCOVERY_NAMESPACE=
# SPRING_CLOUD_NACOS_CONFIG_NAMESPACE=
# 邮箱（QQ SMTP 授权码；键名必须叫 MAIL_TOKEN，user/message 两服务共用）
MAIL_USERNAME=
MAIL_TOKEN=
# Elasticsearch 账号密码：ES 开启安全认证时填写（留空 = 不认证）
ES_USERNAME=elastic
ES_PASSWORD=
